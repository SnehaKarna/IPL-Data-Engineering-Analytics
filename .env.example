# Local Ollama service and models
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=phi3:mini
OLLAMA_EMBED_MODEL=nomic-embed-text

# Embedded local Qdrant works without a separately running service. Choose cloud to use URL/key instead.
QDRANT_BACKEND=local
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_PATH=.qdrant
QDRANT_COLLECTION=ipl_gold_strategy_v2

# Local chase model artifact. Generate it with `python -m ml.train_chase_model` if absent.
CHASE_MODEL_PATH=models/chase_model.joblib
